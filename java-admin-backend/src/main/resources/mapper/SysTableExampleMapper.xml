<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.admin.repository.SysTableExampleRepository">

    <!-- 根据父ID查询子节点 -->
    <select id="findByParentId" parameterType="String" resultType="com.example.admin.entity.SysTableExample">
        SELECT * FROM sys_table_example WHERE parent_id = #{parentId}
    </select>

</mapper>