<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.admin.repository.SysTableExampleRepository">

    <select id="findRootNodes" resultType="com.example.admin.entity.SysTableExample">
        SELECT * FROM sys_table_example WHERE parent_id IS NULL OR parent_id = ''
    </select>

    <select id="findByParentId" resultType="com.example.admin.entity.SysTableExample">
        SELECT * FROM sys_table_example WHERE parent_id = #{parentId}
    </select>

</mapper>