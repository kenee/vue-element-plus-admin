<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.admin.repository.SysUserRepository">

    <select id="findByUsername" resultType="com.example.admin.entity.SysUser">
        SELECT * FROM sys_user WHERE username = #{username}
    </select>

    <select id="existsByUsername" resultType="java.lang.Boolean">
        SELECT COUNT(*) > 0 FROM sys_user WHERE username = #{username}
    </select>

</mapper>