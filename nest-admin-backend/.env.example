# 环境配置文件示例
# 复制此文件为 .env.dev, .env.test, .env.pro 并根据需要修改

# 应用配置
NODE_ENV=development
PORT=3000
API_PREFIX=api

# 数据库配置
DB_TYPE=mysql
DB_HOST=localhost
DB_PORT=3307
DB_USERNAME=root
DB_PASSWORD=root
DB_DATABASE=nest_admin

# JWT 配置
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRES_IN=60m

# CORS 配置
CORS_ORIGIN=http://localhost:4000
